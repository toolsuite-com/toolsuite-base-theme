{%- comment -%} Password page — a paper page: wordmark, hairline, serif
  message, underline-only password row. No frosted card, no scrim, no radius.
  The optional background image is an image_picker (Shopify Files, e.g.
  brand-hero) rather than a bundled asset. {%- endcomment -%}
<section class="pw">
  {%- if section.settings.image != blank -%}
    <div class="pw__bg" aria-hidden="true">
      <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="" width="1600" height="900" fetchpriority="high">
    </div>
  {%- endif -%}

  <div class="pw__panel">
    <span class="pw__brand">{%- render 'logo-lockup' -%}</span>
    <hr class="rule">
    <h1 class="dl">{{ section.settings.message | escape }}</h1>
    {%- if section.settings.sub_message != blank -%}
      <p class="lbl mute">{{ section.settings.sub_message | escape }}</p>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      <label class="visually-hidden" for="pw-input">{{ 'password_page.store_password_label' | t }}</label>
      <div class="pw__row">
        <input id="pw-input" class="field" type="password" name="password" placeholder="{{ 'password_page.password_placeholder' | t }}" autocomplete="current-password" required>
        <button type="submit" class="tlink">{{ 'password_page.enter' | t }}</button>
      </div>
      {%- if form.errors -%}
        <p class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}

    <p class="lbl-sm mute">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</section>

<style>
  .pw { position: relative; min-height: 100svh; display: grid; place-items: center; padding: var(--gutter); background: var(--paper); overflow: clip; }
  .pw__bg { position: absolute; inset: 0; }
  .pw__bg img { width: 100%; height: 100%; object-fit: cover; opacity: .55; }
  .pw__panel { position: relative; width: min(100%, 30rem); display: grid; gap: 18px; justify-items: center; text-align: center; }
  .pw__brand { display: block; --logo-size: 40px; }
  .pw__row { display: flex; align-items: center; gap: 16px; width: min(100%, 22rem); }
</style>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "message", "label": "Message", "default": "Something warm is coming. We're setting up the store." },
    { "type": "text", "id": "sub_message", "label": "Sub message", "default": "Women's fashion and accessories. Opening soon." },
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" }
  ]
}
{% endschema %}
