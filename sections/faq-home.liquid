{%- comment -%}
  Quiet FAQ, restyled to a hairline list: question row in the
  label system, answer in prose.

  This is the ONLY accordion in the theme — the PDP info sections swap inline
  instead. Markup is native <details class="acc"> with a .acc__body:
  browsers with `interpolate-size` animate it in CSS below, WebKit/iOS gets the
  WAAPI fallback in theme.js (initAccordions), which looks for exactly these
  class names.
{%- endcomment -%}
<section class="sec reveal">
  <div class="wrap wrap--narrow">
    {%- liquid
      assign fq_heading = section.settings.heading
      unless request.locale.primary
        assign fq_heading = 'home.faq.heading' | t
      endunless
    -%}
    {%- if fq_heading != blank -%}
      <h2 class="dl home-faq__head">{{ fq_heading | escape }}</h2>
    {%- endif -%}
    <div class="home-faq bt">
      {%- for block in section.blocks -%}
        <details class="acc bb" {{ block.shopify_attributes }}>
          <summary class="acc__q lbl">
            {%- liquid
              assign fq_q = block.settings.question
              assign fq_a = block.settings.answer
              unless request.locale.primary
                comment
                  per-index locale keys q1..q5; a block beyond the translated set
                  falls back to its own (primary-language) settings rather than
                  printing a translation-missing string
                endcomment
                assign fq_qk = 'home.faq.q' | append: forloop.index | append: '_question'
                assign fq_ak = 'home.faq.q' | append: forloop.index | append: '_answer_html'
                assign fq_qt = fq_qk | t
                assign fq_at = fq_ak | t
                unless fq_qt contains 'Translation missing' or fq_qt contains 'translation missing'
                  assign fq_q = fq_qt
                  assign fq_a = fq_at
                endunless
              endunless
            -%}
            {{ fq_q | escape }}
            <span class="acc__sign" aria-hidden="true"></span>
          </summary>
          <div class="acc__body prose">{{ fq_a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders leave the facility within 1–3 business days and arrive within 8–12 business days, free shipping included.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa" },
        { "type": "qa" },
        { "type": "qa" }
      ]
    }
  ]
}
{% endschema %}
