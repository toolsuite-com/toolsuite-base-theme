{%- comment -%}
  Category typo-block: the category navigation IS the design
  element. Giant Prata uppercase links, stacked, centered, no images, no
  buttons, generous air around them. Measured at ~70–90px rendered on a
  390px viewport; .dxl (clamp 44–96px) is that step.
{%- endcomment -%}
<section class="sec reveal">
  <nav class="wrap typo-list" aria-label="{{ 'category_typo.aria' | t }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = block.settings.collection
        assign url = block.settings.link
        if url == blank and col != blank
          assign url = col.url
        endif
        assign label = block.settings.label | default: col.title
      -%}
      <a class="typo-list__link dxl" href="{{ url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ label | escape }}</a>
    {%- endfor -%}
  </nav>
</section>

{% schema %}
{
  "name": "Category typo-block",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "Rendered uppercase. Falls back to the collection title." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link override", "info": "Leave empty to link to the collection." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category typo-block",
      "blocks": [
        { "type": "category", "settings": { "label": "Dresses", "collection": "womens-dresses" } },
        { "type": "category", "settings": { "label": "Coats", "collection": "womens-coats-jackets" } },
        { "type": "category", "settings": { "label": "Knitwear", "collection": "womens-knitwear" } },
        { "type": "category", "settings": { "label": "Tops", "collection": "womens-tops-blouses" } }
      ]
    }
  ]
}
{% endschema %}
