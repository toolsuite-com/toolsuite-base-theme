<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="icon" type="image/svg+xml" href="{{ 'brand-favicon.svg' | asset_url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ 'brand-favicon-32.png' | asset_url }}">
  <style>
    {%- comment -%} The password page has no PDP, so it never renders the one
    Prata-holdout tags (.pdp__color etc.) — no Prata @font-face needed here at all,
    Archivo covers everything this template can show. {%- endcomment -%}
    @font-face {
      font-family: 'Archivo';
      src: url('{{ 'archivo-var.woff2' | asset_url }}') format('woff2');
      font-weight: 400 700;
      font-style: normal;
      font-display: swap;
    }
    :root {
      --paper: {{ settings.color_paper }};
      --ink: {{ settings.color_ink }};
      --cream: {{ settings.color_cream }};
      --hairline: {{ settings.color_hairline }};
      --mute: {{ settings.color_mute }};
      --font-display: 'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      --font-ui: 'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
